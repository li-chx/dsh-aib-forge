# Browser frontend origin, without a path or trailing slash.
FORGE_ORIGIN=https://aib.example.com

# Host Nginx forwards HTTP to this loopback listener.
FORGE_BIND_IP=127.0.0.1
FORGE_PORT=36936

# Use the AIB commit that matches your deployed frontend.
DSH_REPOSITORY=https://github.com/li-chx/deepseek-harness-all-in-browser.git
DSH_REF=ccec8aaac95174eb5020b919732354bf1df2bb2d

FORGE_REGISTRY=https://registry.npmjs.org/
FORGE_MAX_BUILDS=2
FORGE_MAX_REQUEST_BYTES=2097152
FORGE_INSTALL_TIMEOUT_MS=120000
